# Published: the sources of the tester, the scripts the README uses, the
# ready-made tester, the pictures and the video. Everything else stays local:
# the FNIRSI firmware and anything made from it (fw/, usb/, releases/,
# update/), the test builds that run over SWD and their tools, notes.
/*
!/.gitignore
!/README.md
!/platformio.ini
!/src/
!/tools/
!/bin/
!/docs/

/src/*
!/src/app/
!/src/boot/
!/src/hw/
/src/hw/*
!/src/hw/Lcd.cpp
!/src/hw/Lcd.h
!/src/hw/Probe.cpp
!/src/hw/Probe.h

/tools/*
!/tools/make_update.py
!/tools/usb_receive.py

/docs/*
!/docs/screens/
!/docs/screens.gif
!/docs/screens.mp4
!/docs/buttons.html
